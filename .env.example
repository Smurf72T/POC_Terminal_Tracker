# Пример конфигурации подключения к БД
# Скопируйте в .env и заполните свои значения
POC_DB_HOST=localhost
POC_DB_PORT=5432
POC_DB_NAME=pocbase
POC_DB_USER=postgres
POC_DB_PASSWORD=postgres

# Режим SSL: disable | prefer | require | verify-ca | verify-full
# Для проверки сертификата сервера используйте verify-full и укажите sslrootcert
#POC_DB_SSLMODE=verify-full
#POC_DB_SSLROOTCERT=C:/path/to/root.crt
