# Пример конфигурации подключения к БД
# Скопируйте в .env и заполните свои значения
POC_DB_HOST=localhost
POC_DB_PORT=5432
POC_DB_NAME=pocbase
POC_DB_USER=postgres
POC_DB_PASSWORD=postgres

# ВАЖНО (Linux/Unix): после копирования выполните chmod 600 .env
# (файл содержит пароль). Приложение предупредит в логе, если права
# слишком открытые; исправить автоматически: POC_Terminal_Tracker --fix-env-permissions

# Режим SSL: disable | prefer | require | verify-ca | verify-full
# Дефолт в config.json — require (без TLS подключение отклоняется).
# Для локальной БД без SSL добавьте: POC_DB_SSLMODE=prefer
# Для проверки сертификата сервера используйте verify-full и укажите sslrootcert
#POC_DB_SSLMODE=verify-full
#POC_DB_SSLROOTCERT=C:/path/to/root.crt
