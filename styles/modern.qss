/* Modern Dark Material Design - Улучшенная версия */
QMainWindow, QDialog, QWidget {
    background-color: #1E1E1E;
    color: #E0E0E0;
    font-family: "Segoe UI", Arial, sans-serif;
}

QTableView {
    background-color: #252526;
    alternate-background-color: #2A2A2A;
    color: #E0E0E0;
    gridline-color: #333333;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
    selection-background-color: #1565C0;
    selection-color: white;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2D2D2D, stop:1 #252526);
    color: #FFFFFF;
    padding: 10px 8px;
    border: none;
    border-bottom: 3px solid #0D47A1;
    font-weight: bold;
    font-size: 13px;
}

QPushButton {
    background-color: #0D47A1;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: 500;
    min-width: 110px;
}

QPushButton:hover {
    background-color: #1565C0;
}

QPushButton:pressed {
    background-color: #0A3A7F;
}

QPushButton#btnDelete {
    background-color: #C62828;
}

QPushButton#btnDelete:hover {
    background-color: #E53935;
}

QLineEdit {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 2px solid #3C3C3C;
    border-radius: 6px;
    padding: 8px 10px;
}

QLineEdit:focus {
    border: 2px solid #0D47A1;
    background-color: #323232;
}

QLabel {
    color: #E0E0E0;
}

QStatusBar {
    background-color: #1E1E1E;
    color: #BBBBBB;
}

/* Карточки дашборда */
QFrame[frameShape="4"] { /* StyledPanel */
    background-color: #2D2D2D;
    border-radius: 10px;
    border: 1px solid #3C3C3C;
}

/* GroupBox */
QGroupBox {
    color: #E0E0E0;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
    margin-top: 12px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* ComboBox, DateEdit, SpinBox */
QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}
QComboBox:hover, QDateEdit:hover, QSpinBox:hover {
    border: 1px solid #0D47A1;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* TextEdit */
QTextEdit {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
}

/* ListView */
QListView {
    background-color: #252526;
    color: #E0E0E0;
    border: 1px solid #3C3C3C;
    alternate-background-color: #2A2A2A;
}